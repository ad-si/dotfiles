#!/usr/bin/env bash
#
# compare-songs — compare the real audio quality of two files.
#
# Decodes the actual audio (not just the codec labels) and reports:
#   • container / codec facts (sample rate, bit depth, bitrate, size, channels)
#   • a spectrogram of each, rendered inline in the terminal
#   • high-frequency band energy (RMS >16 kHz and >20 kHz)
#   • channel content: mono/stereo, and whether "stereo" is really dual-mono
#
# The spectrogram + band energy expose lossy brick-wall cutoffs and
# upsampled/transcoded fakes that the codec label alone would hide.
#
# Usage:
#   compare-songs FILE_A FILE_B [-s START] [-d DURATION]
#
#   -s START      start offset in seconds for the analysis window
#                 (default: 1/3 into the shorter file)
#   -d DURATION   spectrogram window length in seconds (default: 20)
#   --no-ai       skip the closing claude verdict on which file to keep
#
# Deps: ffmpeg, ffprobe, sox, and a terminal image viewer
#       (imgcat, viu, chafa, or timg). Optional: claude CLI for the verdict.

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

for bin in ffmpeg ffprobe sox; do
  command -v "$bin" >/dev/null 2>&1 || die "'$bin' not found in PATH"
done

# Pick a terminal image renderer.
render_img() {
  local img="$1"
  if command -v imgcat >/dev/null 2>&1; then imgcat "$img"
  elif command -v viu >/dev/null 2>&1; then viu -w 100 "$img"
  elif command -v chafa >/dev/null 2>&1; then chafa "$img"
  elif command -v timg >/dev/null 2>&1; then timg "$img"
  else
    printf '  (no terminal image viewer found; PNG saved at %s)\n' "$img"
  fi
}

DUR=20
START=""
ASSESS=1          # ask the claude CLI for a keep/discard verdict at the end
FILES=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -s) START="$2"; shift 2 ;;
    -d) DUR="$2"; shift 2 ;;
    --no-ai) ASSESS=0; shift ;;
    -h|--help) sed -n '3,29p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *)  FILES+=("$1"); shift ;;
  esac
done

[[ ${#FILES[@]} -eq 2 ]] || die "need exactly two files (got ${#FILES[@]})"
A="${FILES[0]}"; B="${FILES[1]}"
[[ -f "$A" ]] || die "no such file: $A"
[[ -f "$B" ]] || die "no such file: $B"

TMP="$(mktemp -d "${TMPDIR:-/tmp}/compare-songs.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

# --- helpers -----------------------------------------------------------------

# Print one stream/format fact via ffprobe.
probe() { ffprobe -v error -show_entries "$1" -of "default=noprint_wrappers=1:nokey=1" "$2" 2>/dev/null | head -1; }

dur_of() { probe "format=duration" "$1"; }

# RMS level (dBFS) of an audio window, optionally high-passed.
# args: file start dur [highpass_hz]
band_rms() {
  local f="$1" ss="$2" d="$3" hp="${4:-}"
  local af="astats=metadata=1:reset=0,ametadata=print:key=lavfi.astats.Overall.RMS_level:file=-"
  if [[ -n "$hp" ]]; then
    # two 2-pole passes for a steeper skirt so the number reflects real content
    af="highpass=f=${hp}:poles=2,highpass=f=${hp}:poles=2,${af}"
  fi
  ffmpeg -hide_banner -vn -ss "$ss" -t "$d" -i "$f" -af "$af" -f null - 2>/dev/null \
    | tail -1 | sed 's/.*=//'
}

# RMS level (dBFS) of the stereo side channel, i.e. 0.5*(L-R). Near-silence
# here means the two channels are identical (dual-mono faking stereo).
# args: file start dur
side_rms() {
  local f="$1" ss="$2" d="$3"
  local af="pan=mono|c0=0.5*c0-0.5*c1,astats=metadata=1:reset=0,ametadata=print:key=lavfi.astats.Overall.RMS_level:file=-"
  ffmpeg -hide_banner -vn -ss "$ss" -t "$d" -i "$f" -af "$af" -f null - 2>/dev/null \
    | tail -1 | sed 's/.*=//'
}

SUMMARY=""   # machine-readable digest fed to the closing verdict

fmt_facts() {
  local f="$1"
  local sr bits codec br size dur ch chlabel line
  codec=$(probe "stream=codec_name" "$f")
  sr=$(probe "stream=sample_rate" "$f")
  bits=$(probe "stream=bits_per_raw_sample" "$f")
  [[ "$bits" == "N/A" || -z "$bits" ]] && bits="?"
  br=$(probe "format=bit_rate" "$f")
  dur=$(dur_of "$f")
  size=$(du -h "$f" | cut -f1)
  ch=$(probe "stream=channels" "$f")
  case "$ch" in
    1) chlabel="1ch (mono)" ;;
    2) chlabel="2ch (stereo)" ;;
    *) chlabel="${ch:-?}ch" ;;
  esac
  line=$(printf 'codec=%s  %s Hz / %s-bit  bitrate=%.0f kbps  size=%s  dur=%.0fs  ch=%s' \
    "$codec" "$sr" "$bits" "$(echo "${br:-0}/1000" | bc -l)" "$size" "${dur%.*}" "$chlabel")
  printf '  %s\n' "$line"
  SUMMARY+="  $line"$'\n'
}

# --- analysis window ---------------------------------------------------------

dA=$(dur_of "$A"); dB=$(dur_of "$B")
shorter=$(echo "if ($dA < $dB) $dA else $dB" | bc -l)
if [[ -z "$START" ]]; then
  START=$(echo "scale=2; $shorter/3" | bc -l)
fi
# Clamp window to available audio.
maxstart=$(echo "$shorter - $DUR" | bc -l)
if (( $(echo "$START > $maxstart" | bc -l) )); then
  START=$(echo "if ($maxstart > 0) $maxstart else 0" | bc -l)
fi

printf '\n\033[1m== compare-songs ==\033[0m  window: %.0fs → +%ss\n\n' "${START%.*}" "$DUR"

SUMMARY+="A: $A"$'\n'; printf '\033[1mA:\033[0m %s\n' "$A"; fmt_facts "$A"
SUMMARY+="B: $B"$'\n'; printf '\033[1mB:\033[0m %s\n' "$B"; fmt_facts "$B"

# --- band energy -------------------------------------------------------------

printf '\n\033[1mBand energy (RMS dBFS over %ss window)\033[0m\n' "$DUR"
header=$(printf '  %-10s %12s %12s %12s' "" "full" ">16 kHz" ">20 kHz")
printf '%s\n' "$header"
SUMMARY+=$'\n'"Band energy (RMS dBFS, ${DUR}s window):"$'\n'"$header"$'\n'
for pair in "A:$A" "B:$B"; do
  label="${pair%%:*}"; f="${pair#*:}"
  full=$(band_rms "$f" "$START" "$DUR")
  h16=$(band_rms "$f" "$START" "$DUR" 16000)
  h20=$(band_rms "$f" "$START" "$DUR" 20000)
  row=$(printf '  %-10s %12.1f %12.1f %12.1f' "$label" "$full" "$h16" "$h20")
  printf '%s\n' "$row"
  SUMMARY+="$row"$'\n'
done
cat <<'EOF'

  Reading it: a lossy file dumps everything above a brick wall (often
  ~16 kHz). If >16 kHz sits far below full and >20 kHz is near silence
  (< -90), that band was thrown away. A genuine lossless master keeps
  a smooth roll-off with real energy above 16 kHz and no hard wall.
EOF

# --- channel content ---------------------------------------------------------

printf '\n\033[1mChannel content\033[0m\n'
chdr=$(printf '  %-10s %14s %14s' "" "channels" "side (L-R)")
printf '%s\n' "$chdr"
SUMMARY+=$'\n'"Channel content:"$'\n'"$chdr"$'\n'
for pair in "A:$A" "B:$B"; do
  label="${pair%%:*}"; f="${pair#*:}"
  ch=$(probe "stream=channels" "$f")
  if [[ "$ch" == "1" ]]; then
    kind="mono"; side="--"
  elif [[ "$ch" == "2" ]]; then
    side=$(side_rms "$f" "$START" "$DUR")
    # A truly silent side channel reads as "-inf"; treat that or a very low
    # level as dual-mono (identical L/R) rather than genuine stereo.
    if [[ "$side" == "-inf" ]] || (( $(echo "${side:-0} < -60" | bc -l) )); then
      kind="dual-mono (fake stereo)"
    else
      kind="stereo"
    fi
  else
    kind="${ch:-?}ch"; side="--"
  fi
  row=$(printf '  %-10s %14s %14s' "$label" "$kind" "$side")
  printf '%s\n' "$row"
  SUMMARY+="$row"$'\n'
done
cat <<'EOF'

  Reading it: the side channel is 0.5*(L-R). Real stereo has meaningful
  energy there; a side level near silence (or -inf) means both channels
  are identical — the file is dual-mono padded out to look like stereo,
  which wastes space without adding information.
EOF

# --- spectrograms ------------------------------------------------------------

spec() { # file out title
  # Decode the window with ffmpeg first so any codec works (sox can't read
  # AAC/m4a and several other containers). Keep the source sample rate so the
  # spectrogram's Nyquist axis still reflects the original, and use 32-bit
  # float to avoid a 16-bit noise floor masking real high-frequency content.
  local wav="$2.wav"
  ffmpeg -hide_banner -v error -vn -ss "$START" -t "$DUR" -i "$1" \
    -c:a pcm_f32le "$wav" 2>/dev/null
  sox "$wav" -n \
    spectrogram -o "$2" -x 1100 -y 513 -z 120 -t "$3" 2>/dev/null
}

spec "$A" "$TMP/a.png" "A: $(basename "$A")"
spec "$B" "$TMP/b.png" "B: $(basename "$B")"

# Combine side by side (A | B) into one image for direct comparison.
combined="$TMP/combined.png"
if ffmpeg -hide_banner -v error -i "$TMP/a.png" -i "$TMP/b.png" \
     -filter_complex "[0][1]hstack=inputs=2" "$combined" 2>/dev/null; then :
elif command -v magick >/dev/null 2>&1; then
  magick "$TMP/a.png" "$TMP/b.png" +append "$combined"
else
  combined=""   # give up on combining; fall back to the two separate images
fi

printf '\n\033[1mSpectrograms\033[0m  (A: left   |   B: right)\n'
if [[ -n "$combined" ]]; then
  render_img "$combined"
else
  render_img "$TMP/a.png"; render_img "$TMP/b.png"
fi

printf '\nNote: each panel spans DC→Nyquist for its own sample rate, so the top\n'
printf 'of the axis differs between A and B. Watch for a hard horizontal cutoff.\n\n'

# --- verdict -----------------------------------------------------------------

if [[ "$ASSESS" -eq 1 ]] && command -v claude >/dev/null 2>&1; then
  printf '\033[1mVerdict\033[0m (claude, from the measured data)\n'
  prompt=$(cat <<EOF
You are judging the audio quality of two files, A and B, to decide which to
KEEP and which to discard. Below is measured data from decoding the actual
audio (not just codec labels).

$SUMMARY

How to read it:
- A lossy encode discards everything above a brick-wall cutoff (often ~16 kHz).
  Telltale: >16 kHz RMS sits far below the full-band RMS and >20 kHz is near
  silence (roughly < -90 dBFS).
- A genuine lossless master keeps a smooth roll-off with real energy above
  16 kHz and no hard wall. Note that old analog recordings are legitimately
  band-limited, so a gentle roll-off is fine and not a sign of lossy encoding.
- A larger container or higher sample rate does NOT by itself mean higher
  quality; judge by the actual high-frequency content, then by bitrate/codec.
- Channel content matters: genuine stereo carries real energy in the side
  (L-R) channel. A file labelled stereo whose side channel is near silence
  (or -inf) is dual-mono — identical L/R padded to two channels, wasting
  space with no extra information. Prefer a real stereo file over a fake one;
  and if the two files are otherwise equal, prefer the one that isn't merely
  dual-mono. Mono is legitimate for genuinely mono sources (e.g. old
  recordings) — only flag it as a downside when the counterpart is true stereo.

Give your assessment in under 120 words: state which file to KEEP (A or B and
its name), the single clearest reason from the data, and any caveat worth
knowing (e.g. oversampled source, or a lossless file that could be safely
downsampled to save space).

Then, as the very last line of your reply and nothing after it, print the
path of the file to DISCARD in exactly this form:

DISCARD=<full path of the file to discard>
EOF
)
  verdict=$(claude -p "$prompt" 2>/dev/null) || verdict=""
  if [[ -n "$verdict" ]]; then
    # Strip the machine-readable DISCARD line from the human-facing verdict.
    printf '%s\n' "$verdict" | grep -v '^DISCARD='
    discard=$(printf '%s\n' "$verdict" | sed -n 's/^DISCARD=//p' | tail -1)
    if [[ -n "$discard" ]]; then
      printf '\n\033[1mTo discard the lower-quality file, run:\033[0m\n'
      printf '  trash %q\n' "$discard"
    fi
  else
    printf '  (claude verdict unavailable)\n'
  fi
  printf '\n'
fi
