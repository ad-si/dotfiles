#!/bin/dash

set -euf

# More powerful `git status` command that supports directories
# containing several git repositories as well.

color () {
  case "$1" in
    red)    colorCode="1;31" ;;
    green)  colorCode="1;32" ;;
    yellow) colorCode="1;33" ;;
    blue)   colorCode="1;34" ;;
    *)
      printf "Invalid color code: %s\n" "$1"
      exit 1
      ;;
  esac

  shift
  printf "\033[%sm%s\033[0m\n" "$colorCode" "$1"
}

gitDirs="$(find . -maxdepth 2 -type d -name '.git' | sort)"

# If only one git repository is found, run `git status` directly
if test "$(echo "$gitDirs" | wc -l)" -eq 1
then
  git -C "$(dirname "$gitDirs")" status --short
  exit 0
fi

# Determine the widest repo name so the flake/stats columns line up
nameWidth="$(
  echo "$gitDirs" \
  | while read -r gitdir
    do
      basename "$(dirname "$gitdir")" | awk '{ print length }'
    done \
  | sort -rn \
  | head -1
)"

echo "$gitDirs" \
| while read -r gitdir
  do
    gitdir="$(dirname "$gitdir")"
    gitdirBasename="$(basename "$gitdir")"

    # Skip directories that aren't valid git repos instead of aborting
    if ! gitStatus="$(git -C "$gitdir" status --porcelain 2>/dev/null)"
    then
      printf "%s %s\n" "$(color red "NOT A REPO")" "$gitdirBasename"
      continue
    fi

    dateLastCommit="$(git -C "$gitdir" log -1 --format=%cs 2>/dev/null || color red "NO COMMITS")"
    numMod="$(echo "$gitStatus" | grep -c '^ M ' || true)"
    numDel="$(echo "$gitStatus" | grep -c '^ D ' || true)"
    numUntrack="$(echo "$gitStatus" | grep -c '^?? ' || true)"
    hasFlakeFile="$(find "$gitdir" -maxdepth 1 -name 'flake.nix')"

    # Pad the name to a fixed visible width before coloring so the flake
    # column lines up regardless of color codes or repo state
    namePadded="$(printf "%-${nameWidth}s" "$gitdirBasename")"
    if test ! -z "$hasFlakeFile"
    then
      flake="$(color blue "❄️")"
    else
      flake="  "
    fi

    # If changes, print stats about repo
    if test -z "$gitStatus"
    then
      printf \
        "%s %s %s\n" \
        "$dateLastCommit" \
        "$namePadded" \
        "$flake"
    else
      printf \
        "%s %s %s (%3s,%3s,%3s)\n" \
        "$dateLastCommit" \
        "$(color yellow "$namePadded")" \
        "$flake" \
        "$(if test "$numMod" != "0"; then color red "$numMod M"; fi)" \
        "$(if test "$numDel" != "0"; then color blue " $numDel D"; fi)" \
        "$(if test "$numUntrack" != "0"; then color green " $numUntrack U"; fi)"
    fi
  done
