#! /usr/bin/env dash

# Run a command, retrying on exit code 139 (segfault). The WolframKernel
# occasionally crashes on cold-start under high-volume sequential
# invocation (e.g. a full `scrut test tests/cli` sweep). stdout/stderr are
# captured per attempt so a crashed attempt's partial output is discarded
# and only the final attempt's streams are emitted.
run_with_retry() {
  out=$(mktemp)
  err=$(mktemp)
  i=0
  while :
  do
    "$@" >"$out" 2>"$err"
    code=$?
    if test "$code" -ne 139 || test "$i" -ge 3
    then break
    fi
    i=$((i + 1))
  done
  cat "$out"
  cat "$err" >&2
  rm -f "$out" "$err"
  return "$code"
}

if test -n "$WOXI_USE_WOLFRAM"
then
  if test "$(printf "%s" "$1" | grep -q '^FullForm'; echo $?)" -eq 0
  then run_with_retry wolframscript -charset UTF-8 -format OutputForm -c "$*"
  else run_with_retry wolframscript -charset UTF-8 -c "$*"
  fi

elif test -n "$WOXI_USE_MATHICS"
then
  mathicsscript -c "$*"

elif test -n "$WOXI_USE_HASKRAM"
then
  haskram eval "$*"

# TODO: Add support for https://github.com/coffeemug/ts-wolfram
# elif test -n "$WOXI_USE_TS"
# then
#   ts-wolfram eval "$*"

else
  # Check if we are in the Woxi project directory
  if test "$(pwd | grep -E "^$HOME/Dropbox/Projects/Woxi(/|$)")"
  then cargo run --quiet -- eval "$*"
  else woxi eval "$*"
  fi
fi
