#!/bin/dash

set -euf

filepath="$1"
pdfMime="application/pdf; charset=binary"

if ! test -e "$filepath"
then
  echo "File does not exist"
  exit 1
fi

filetype=$(file -b --mime "$filepath")

if ! test "$filetype" = "$pdfMime"
then
  echo "File must be of type '$pdfMime' and not '$filetype'"
  exit 1
fi

gs \
  -sDEVICE=txtwrite \
  -o "${filepath%.pdf}.txt" \
  "$filepath"
