<snippet>
    <description>Create a new entry for a Transity journal file</description>
    <content><![CDATA[
  -
    utc: '${1:}'
    transfers:
      - from: ${2:}
        to: ${3:}
        amount: ${4:} €
        tags: [${5:}]
]]></content>
    <!-- Optional: Set a tabTrigger to define how to trigger the snippet -->
    <tabTrigger>transity-entry</tabTrigger>
    <!-- Optional: Set a scope to limit where the snippet will trigger -->
    <scope>source.yaml</scope>
</snippet>
